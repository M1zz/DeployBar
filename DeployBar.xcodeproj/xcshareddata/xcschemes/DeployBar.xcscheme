            <ActionContent
               title = "/Applications 에 설치"
               scriptText = "APP=&quot;$BUILT_PRODUCTS_DIR/$FULL_PRODUCT_NAME&quot;&#10;DEST=&quot;/Applications/$FULL_PRODUCT_NAME&quot;&#10;[ -d &quot;$APP&quot; ] || exit 0&#10;PIDS=$(pgrep -x DeployBar | paste -sd, -)&#10;if [ -n &quot;$PIDS&quot; ] &amp;&amp; lsof -p &quot;$PIDS&quot; 2&gt;/dev/null | grep -q &quot;/Application Support/DeployBar/logs/&quot;; then&#10;  echo &quot;DeployBar 가 배포 중이라 /Applications 는 그대로 둡니다&quot;; exit 0&#10;fi&#10;pkill -x DeployBar&#10;for _ in $(seq 40); do pgrep -x DeployBar &gt;/dev/null || break; sleep 0.25; done&#10;rsync -a --delete &quot;$APP/&quot; &quot;$DEST/&quot; &amp;&amp; open &quot;$DEST&quot;&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "F7093A706C16CAF06473EC86"
                     BuildableName = "DeployBar.app"
                     BlueprintName = "DeployBar"
                     ReferencedContainer = "container:DeployBar.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
